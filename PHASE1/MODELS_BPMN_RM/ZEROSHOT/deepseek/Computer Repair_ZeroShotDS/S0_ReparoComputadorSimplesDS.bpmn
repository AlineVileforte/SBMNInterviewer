      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="Flow_Par4_RS4_di" bpmnElement="Flow_Par4_RS4">
        <ns3:waypoint x="900" y="125" />
        <ns3:waypoint x="1000" y="140" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="Flow_Par4_RH5_di" bpmnElement="Flow_Par4_RH5">
        <ns3:waypoint x="900" y="125" />
