<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_001" isExecutable="false">
    <ns0:startEvent id="Default_init">
      <ns0:outgoing>Flow_Default_init_RC1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="RC1" name="Receber computador">
      <ns0:incoming>Flow_Default_init_RC1</ns0:incoming>
      <ns0:outgoing>Flow_RC1_G0</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G0">
      <ns0:incoming>Flow_RC1_G0</ns0:incoming>
      <ns0:outgoing>Flow_G0_DS3</ns0:outgoing>
      <ns0:outgoing>Flow_G0_FO2</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="DS3" name="Devolver computador sem reparo">
      <ns0:incoming>Flow_G0_DS3</ns0:incoming>
      <ns0:outgoing>Flow_DS3_XORCLOSE10</ns0:outgoing>
    </ns0:task>
    <ns0:task id="FO2" name="Fazer or&#231;amento">
      <ns0:incoming>Flow_G0_FO2</ns0:incoming>
      <ns0:outgoing>Flow_FO2_Par4</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="Par4">
      <ns0:incoming>Flow_FO2_Par4</ns0:incoming>
      <ns0:outgoing>Flow_Par4_RS4</ns0:outgoing>
      <ns0:outgoing>Flow_Par4_RH5</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:task id="RS4" name="Reinstalar software">
      <ns0:incoming>Flow_Par4_RS4</ns0:incoming>
      <ns0:outgoing>Flow_RS4_PARCLOSE7</ns0:outgoing>
    </ns0:task>
    <ns0:task id="RH5" name="Reparar hardware">
      <ns0:incoming>Flow_Par4_RH5</ns0:incoming>
      <ns0:outgoing>Flow_RH5_PARCLOSE7</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="PARCLOSE7">
      <ns0:incoming>Flow_RS4_PARCLOSE7</ns0:incoming>
      <ns0:incoming>Flow_RH5_PARCLOSE7</ns0:incoming>
      <ns0:outgoing>Flow_PARCLOSE7_TE6</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:task id="TE6" name="Testar">
      <ns0:incoming>Flow_PARCLOSE7_TE6</ns0:incoming>
      <ns0:outgoing>Flow_TE6_DR7</ns0:outgoing>
    </ns0:task>
    <ns0:task id="DR7" name="Devolver computador reparado">
      <ns0:incoming>Flow_TE6_DR7</ns0:incoming>
      <ns0:outgoing>Flow_DR7_XORCLOSE10</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="XORCLOSE10">
      <ns0:incoming>Flow_DS3_XORCLOSE10</ns0:incoming>
      <ns0:incoming>Flow_DR7_XORCLOSE10</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE10_END</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="END">
      <ns0:incoming>Flow_XORCLOSE10_END</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Default_init_RC1" sourceRef="Default_init" targetRef="RC1" />
    <ns0:sequenceFlow id="Flow_RC1_G0" sourceRef="RC1" targetRef="G0" />
    <ns0:sequenceFlow id="Flow_G0_DS3" sourceRef="G0" targetRef="DS3" />
    <ns0:sequenceFlow id="Flow_G0_FO2" sourceRef="G0" targetRef="FO2" />
    <ns0:sequenceFlow id="Flow_DS3_XORCLOSE10" sourceRef="DS3" targetRef="XORCLOSE10" />
    <ns0:sequenceFlow id="Flow_FO2_Par4" sourceRef="FO2" targetRef="Par4" />
    <ns0:sequenceFlow id="Flow_Par4_RS4" sourceRef="Par4" targetRef="RS4" />
    <ns0:sequenceFlow id="Flow_Par4_RH5" sourceRef="Par4" targetRef="RH5" />
    <ns0:sequenceFlow id="Flow_RS4_PARCLOSE7" sourceRef="RS4" targetRef="PARCLOSE7" />
    <ns0:sequenceFlow id="Flow_RH5_PARCLOSE7" sourceRef="RH5" targetRef="PARCLOSE7" />
    <ns0:sequenceFlow id="Flow_PARCLOSE7_TE6" sourceRef="PARCLOSE7" targetRef="TE6" />
    <ns0:sequenceFlow id="Flow_TE6_DR7" sourceRef="TE6" targetRef="DR7" />
    <ns0:sequenceFlow id="Flow_DR7_XORCLOSE10" sourceRef="DR7" targetRef="XORCLOSE10" />
    <ns0:sequenceFlow id="Flow_XORCLOSE10_END" sourceRef="XORCLOSE10" targetRef="END" />
  </ns0:process>
  <ns1:BPMNDiagram id="BPMNDiagram_1">
    <ns1:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_001">
      <ns1:BPMNShape id="_BPMNShape_Default_init" bpmnElement="Default_init">
        <ns2:Bounds x="100" y="100" width="36" height="36" />
