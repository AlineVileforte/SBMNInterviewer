      <ns1:BPMNShape id="_BPMNShape_PARCLOSE7" bpmnElement="PARCLOSE7">
        <ns2:Bounds x="1300" y="100" width="50" height="50" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="_BPMNShape_TE6" bpmnElement="TE6">
        <ns2:Bounds x="1450" y="100" width="100" height="80" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="_BPMNShape_DR7" bpmnElement="DR7">
        <ns2:Bounds x="1600" y="100" width="100" height="80" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="_BPMNShape_XORCLOSE10" bpmnElement="XORCLOSE10">
        <ns2:Bounds x="1750" y="100" width="50" height="50" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="_BPMNShape_END" bpmnElement="END">
        <ns2:Bounds x="1900" y="100" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNEdge id="Flow_Default_init_RC1_di" bpmnElement="Flow_Default_init_RC1">
        <ns3:waypoint x="136" y="118" />
        <ns3:waypoint x="250" y="140" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="Flow_RC1_G0_di" bpmnElement="Flow_RC1_G0">
        <ns3:waypoint x="350" y="140" />
