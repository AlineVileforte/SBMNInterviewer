<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_001" isExecutable="false">
    <ns0:startEvent id="Default_init">
      <ns0:outgoing>Flow_Default_init_Rc1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="Rc1" name="Receive_Computer">
      <ns0:incoming>Flow_Default_init_Rc1</ns0:incoming>
      <ns0:outgoing>Flow_Rc1_Or1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Or1" name="Make_Budget">
      <ns0:incoming>Flow_Rc1_Or1</ns0:incoming>
      <ns0:outgoing>Flow_Or1_G0</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G0">
      <ns0:incoming>Flow_Or1_G0</ns0:incoming>
      <ns0:outgoing>Flow_G0_Hw1</ns0:outgoing>
      <ns0:outgoing>Flow_G0_G1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="Hw1" name="Repair_Hardware">
      <ns0:incoming>Flow_G0_Hw1</ns0:incoming>
      <ns0:outgoing>Flow_Hw1_XORCLOSE12</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G1">
      <ns0:incoming>Flow_G0_G1</ns0:incoming>
      <ns0:outgoing>Flow_G1_Par6</ns0:outgoing>
      <ns0:outgoing>Flow_G1_Sr1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="Sr1" name="Return_Computer_Without_Repair">
      <ns0:incoming>Flow_G1_Sr1</ns0:incoming>
      <ns0:outgoing>Flow_Sr1_XORCLOSE11</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="Par6">
      <ns0:incoming>Flow_G1_Par6</ns0:incoming>
      <ns0:outgoing>Flow_Par6_Dr1</ns0:outgoing>
      <ns0:outgoing>Flow_Par6_Te1</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:task id="Dr1" name="Return_Repaired_Computer">
      <ns0:incoming>Flow_Par6_Dr1</ns0:incoming>
      <ns0:outgoing>Flow_Dr1_Sw1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Sw1" name="Reinstall_Software">
      <ns0:incoming>Flow_Dr1_Sw1</ns0:incoming>
      <ns0:outgoing>Flow_Sw1_PARCLOSE10</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Te1" name="Test">
      <ns0:incoming>Flow_Par6_Te1</ns0:incoming>
      <ns0:outgoing>Flow_Te1_PARCLOSE10</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="PARCLOSE10">
      <ns0:incoming>Flow_Sw1_PARCLOSE10</ns0:incoming>
      <ns0:incoming>Flow_Te1_PARCLOSE10</ns0:incoming>
      <ns0:outgoing>Flow_PARCLOSE10_XORCLOSE11</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:exclusiveGateway id="XORCLOSE11">
      <ns0:incoming>Flow_Sr1_XORCLOSE11</ns0:incoming>
      <ns0:incoming>Flow_PARCLOSE10_XORCLOSE11</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE11_XORCLOSE12</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="XORCLOSE12">
      <ns0:incoming>Flow_Hw1_XORCLOSE12</ns0:incoming>
      <ns0:incoming>Flow_XORCLOSE11_XORCLOSE12</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE12_END</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="END">
      <ns0:incoming>Flow_XORCLOSE12_END</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Default_init_Rc1" sourceRef="Default_init" targetRef="Rc1" />
    <ns0:sequenceFlow id="Flow_Rc1_Or1" sourceRef="Rc1" targetRef="Or1" />
    <ns0:sequenceFlow id="Flow_Or1_G0" sourceRef="Or1" targetRef="G0" />
    <ns0:sequenceFlow id="Flow_G0_Hw1" sourceRef="G0" targetRef="Hw1" />
    <ns0:sequenceFlow id="Flow_G0_G1" sourceRef="G0" targetRef="G1" />
    <ns0:sequenceFlow id="Flow_Hw1_XORCLOSE12" sourceRef="Hw1" targetRef="XORCLOSE12" />
    <ns0:sequenceFlow id="Flow_G1_Par6" sourceRef="G1" targetRef="Par6" />
    <ns0:sequenceFlow id="Flow_G1_Sr1" sourceRef="G1" targetRef="Sr1" />
    <ns0:sequenceFlow id="Flow_Sr1_XORCLOSE11" sourceRef="Sr1" targetRef="XORCLOSE11" />
    <ns0:sequenceFlow id="Flow_Par6_Dr1" sourceRef="Par6" targetRef="Dr1" />
    <ns0:sequenceFlow id="Flow_Par6_Te1" sourceRef="Par6" targetRef="Te1" />
    <ns0:sequenceFlow id="Flow_Dr1_Sw1" sourceRef="Dr1" targetRef="Sw1" />
    <ns0:sequenceFlow id="Flow_Sw1_PARCLOSE10" sourceRef="Sw1" targetRef="PARCLOSE10" />
    <ns0:sequenceFlow id="Flow_Te1_PARCLOSE10" sourceRef="Te1" targetRef="PARCLOSE10" />
    <ns0:sequenceFlow id="Flow_PARCLOSE10_XORCLOSE11" sourceRef="PARCLOSE10" targetRef="XORCLOSE11" />
    <ns0:sequenceFlow id="Flow_XORCLOSE11_XORCLOSE12" sourceRef="XORCLOSE11" targetRef="XORCLOSE12" />
    <ns0:sequenceFlow id="Flow_XORCLOSE12_END" sourceRef="XORCLOSE12" targetRef="END" />
  </ns0:process>
