<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_001" isExecutable="false">
    <ns0:startEvent id="Default_init">
      <ns0:outgoing>Flow_Default_init_Rs1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="Rs1" name="Registrar solicitacao">
      <ns0:incoming>Flow_Default_init_Rs1</ns0:incoming>
      <ns0:outgoing>Flow_Rs1_Cl1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Cl1" name="Classificar solicitacao">
      <ns0:incoming>Flow_Rs1_Cl1</ns0:incoming>
      <ns0:outgoing>Flow_Cl1_G0</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G0">
      <ns0:incoming>Flow_Cl1_G0</ns0:incoming>
      <ns0:outgoing>Flow_G0_Par4</ns0:outgoing>
      <ns0:outgoing>Flow_G0_Es1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="Es1" name="Executar suporte tecnico">
      <ns0:incoming>Flow_G0_Es1</ns0:incoming>
      <ns0:outgoing>Flow_Es1_XORCLOSE8</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="Par4">
      <ns0:incoming>Flow_G0_Par4</ns0:incoming>
      <ns0:outgoing>Flow_Par4_Ag1</ns0:outgoing>
      <ns0:outgoing>Flow_Par4_Ep1</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:task id="Ag1" name="Agendar atendimento presencial">
      <ns0:incoming>Flow_Par4_Ag1</ns0:incoming>
      <ns0:outgoing>Flow_Ag1_PARCLOSE7</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Ep1" name="Executar atendimento presencial">
      <ns0:incoming>Flow_Par4_Ep1</ns0:incoming>
      <ns0:outgoing>Flow_Ep1_PARCLOSE7</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="PARCLOSE7">
      <ns0:incoming>Flow_Ag1_PARCLOSE7</ns0:incoming>
      <ns0:incoming>Flow_Ep1_PARCLOSE7</ns0:incoming>
      <ns0:outgoing>Flow_PARCLOSE7_XORCLOSE8</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:exclusiveGateway id="XORCLOSE8">
      <ns0:incoming>Flow_Es1_XORCLOSE8</ns0:incoming>
      <ns0:incoming>Flow_PARCLOSE7_XORCLOSE8</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE8_En1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="En1" name="Encerrar atendimento">
      <ns0:incoming>Flow_XORCLOSE8_En1</ns0:incoming>
      <ns0:outgoing>Flow_En1_Nt1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Nt1" name="Notificar cliente">
      <ns0:incoming>Flow_En1_Nt1</ns0:incoming>
      <ns0:outgoing>Flow_Nt1_END</ns0:outgoing>
    </ns0:task>
    <ns0:endEvent id="END">
      <ns0:incoming>Flow_Nt1_END</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Default_init_Rs1" sourceRef="Default_init" targetRef="Rs1" />
    <ns0:sequenceFlow id="Flow_Rs1_Cl1" sourceRef="Rs1" targetRef="Cl1" />
    <ns0:sequenceFlow id="Flow_Cl1_G0" sourceRef="Cl1" targetRef="G0" />
    <ns0:sequenceFlow id="Flow_G0_Par4" sourceRef="G0" targetRef="Par4" />
    <ns0:sequenceFlow id="Flow_G0_Es1" sourceRef="G0" targetRef="Es1" />
    <ns0:sequenceFlow id="Flow_Es1_XORCLOSE8" sourceRef="Es1" targetRef="XORCLOSE8" />
    <ns0:sequenceFlow id="Flow_Par4_Ag1" sourceRef="Par4" targetRef="Ag1" />
    <ns0:sequenceFlow id="Flow_Par4_Ep1" sourceRef="Par4" targetRef="Ep1" />
    <ns0:sequenceFlow id="Flow_Ag1_PARCLOSE7" sourceRef="Ag1" targetRef="PARCLOSE7" />
    <ns0:sequenceFlow id="Flow_Ep1_PARCLOSE7" sourceRef="Ep1" targetRef="PARCLOSE7" />
    <ns0:sequenceFlow id="Flow_PARCLOSE7_XORCLOSE8" sourceRef="PARCLOSE7" targetRef="XORCLOSE8" />
    <ns0:sequenceFlow id="Flow_XORCLOSE8_En1" sourceRef="XORCLOSE8" targetRef="En1" />
    <ns0:sequenceFlow id="Flow_En1_Nt1" sourceRef="En1" targetRef="Nt1" />
    <ns0:sequenceFlow id="Flow_Nt1_END" sourceRef="Nt1" targetRef="END" />
  </ns0:process>
