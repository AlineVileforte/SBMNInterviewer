<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_001" isExecutable="false">
    <ns0:startEvent id="Default_init">
      <ns0:outgoing>Flow_Default_init_RS1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="RS1" name="Registrar solicita&#231;&#227;o">
      <ns0:incoming>Flow_Default_init_RS1</ns0:incoming>
      <ns0:outgoing>Flow_RS1_CS2</ns0:outgoing>
    </ns0:task>
    <ns0:task id="CS2" name="Classificar solicita&#231;&#227;o">
      <ns0:incoming>Flow_RS1_CS2</ns0:incoming>
      <ns0:outgoing>Flow_CS2_AP3</ns0:outgoing>
    </ns0:task>
    <ns0:task id="AP3" name="Agendar atendimento presencial">
      <ns0:incoming>Flow_CS2_AP3</ns0:incoming>
      <ns0:outgoing>Flow_AP3_G0</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G0">
      <ns0:incoming>Flow_AP3_G0</ns0:incoming>
      <ns0:outgoing>Flow_G0_ES5</ns0:outgoing>
      <ns0:outgoing>Flow_G0_EA4</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="ES5" name="Executar suporte t&#233;cnico">
      <ns0:incoming>Flow_G0_ES5</ns0:incoming>
      <ns0:outgoing>Flow_ES5_XORCLOSE6</ns0:outgoing>
    </ns0:task>
    <ns0:task id="EA4" name="Executar atendimento presencial">
      <ns0:incoming>Flow_G0_EA4</ns0:incoming>
      <ns0:outgoing>Flow_EA4_XORCLOSE6</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="XORCLOSE6">
      <ns0:incoming>Flow_ES5_XORCLOSE6</ns0:incoming>
      <ns0:incoming>Flow_EA4_XORCLOSE6</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE6_NC7</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="NC7" name="Notificar cliente">
      <ns0:incoming>Flow_XORCLOSE6_NC7</ns0:incoming>
      <ns0:outgoing>Flow_NC7_EN6</ns0:outgoing>
    </ns0:task>
    <ns0:task id="EN6" name="Encerrar atendimento">
      <ns0:incoming>Flow_NC7_EN6</ns0:incoming>
      <ns0:outgoing>Flow_EN6_END</ns0:outgoing>
    </ns0:task>
    <ns0:endEvent id="END">
      <ns0:incoming>Flow_EN6_END</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Default_init_RS1" sourceRef="Default_init" targetRef="RS1" />
    <ns0:sequenceFlow id="Flow_RS1_CS2" sourceRef="RS1" targetRef="CS2" />
    <ns0:sequenceFlow id="Flow_CS2_AP3" sourceRef="CS2" targetRef="AP3" />
    <ns0:sequenceFlow id="Flow_AP3_G0" sourceRef="AP3" targetRef="G0" />
    <ns0:sequenceFlow id="Flow_G0_ES5" sourceRef="G0" targetRef="ES5" />
    <ns0:sequenceFlow id="Flow_G0_EA4" sourceRef="G0" targetRef="EA4" />
    <ns0:sequenceFlow id="Flow_ES5_XORCLOSE6" sourceRef="ES5" targetRef="XORCLOSE6" />
    <ns0:sequenceFlow id="Flow_EA4_XORCLOSE6" sourceRef="EA4" targetRef="XORCLOSE6" />
    <ns0:sequenceFlow id="Flow_XORCLOSE6_NC7" sourceRef="XORCLOSE6" targetRef="NC7" />
    <ns0:sequenceFlow id="Flow_NC7_EN6" sourceRef="NC7" targetRef="EN6" />
    <ns0:sequenceFlow id="Flow_EN6_END" sourceRef="EN6" targetRef="END" />
  </ns0:process>
