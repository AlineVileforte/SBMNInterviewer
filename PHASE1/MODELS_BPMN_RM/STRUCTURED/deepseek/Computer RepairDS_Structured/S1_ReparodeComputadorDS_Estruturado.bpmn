<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_001" isExecutable="false">
    <ns0:startEvent id="Default_init">
      <ns0:outgoing>Flow_Default_init_Rc1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="Rc1" name="Receber computador">
      <ns0:incoming>Flow_Default_init_Rc1</ns0:incoming>
      <ns0:outgoing>Flow_Rc1_Fo1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Fo1" name="Fazer or&#231;amento">
      <ns0:incoming>Flow_Rc1_Fo1</ns0:incoming>
      <ns0:outgoing>Flow_Fo1_G0</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G0">
      <ns0:incoming>Flow_Fo1_G0</ns0:incoming>
      <ns0:outgoing>Flow_G0_Ds1</ns0:outgoing>
      <ns0:outgoing>Flow_G0_Par4</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="Ds1" name="Devolver computador sem reparo">
      <ns0:incoming>Flow_G0_Ds1</ns0:incoming>
      <ns0:outgoing>Flow_Ds1_XORCLOSE10</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="Par4">
      <ns0:incoming>Flow_XOR_JMPAA_Te1_Par4_Par4</ns0:incoming>
      <ns0:incoming>Flow_G0_Par4</ns0:incoming>
      <ns0:outgoing>Flow_Par4_Rs1</ns0:outgoing>
      <ns0:outgoing>Flow_Par4_Rh1</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:task id="Rs1" name="Reinstalar software">
      <ns0:incoming>Flow_Par4_Rs1</ns0:incoming>
      <ns0:outgoing>Flow_Rs1_PARCLOSE7</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Rh1" name="Reparar hardware">
      <ns0:incoming>Flow_Par4_Rh1</ns0:incoming>
      <ns0:outgoing>Flow_Rh1_PARCLOSE7</ns0:outgoing>
    </ns0:task>
    <ns0:parallelGateway id="PARCLOSE7">
      <ns0:incoming>Flow_Rs1_PARCLOSE7</ns0:incoming>
      <ns0:incoming>Flow_Rh1_PARCLOSE7</ns0:incoming>
      <ns0:outgoing>Flow_PARCLOSE7_Te1</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:task id="Te1" name="Testar">
      <ns0:incoming>Flow_PARCLOSE7_Te1</ns0:incoming>
      <ns0:outgoing>Flow_Te1_XOR_JMPAA_Te1_Par4</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Dr1" name="Devolver computador reparado">
      <ns0:incoming>Flow_XOR_JMPAA_Te1_Par4_Dr1</ns0:incoming>
      <ns0:outgoing>Flow_Dr1_XORCLOSE10</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="XORCLOSE10">
      <ns0:incoming>Flow_Ds1_XORCLOSE10</ns0:incoming>
      <ns0:incoming>Flow_Dr1_XORCLOSE10</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE10_END</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="END">
      <ns0:incoming>Flow_XORCLOSE10_END</ns0:incoming>
    </ns0:endEvent>
    <ns0:exclusiveGateway id="XOR_JMPAA_Te1_Par4">
      <ns0:incoming>Flow_Te1_XOR_JMPAA_Te1_Par4</ns0:incoming>
      <ns0:outgoing>Flow_XOR_JMPAA_Te1_Par4_Dr1</ns0:outgoing>
      <ns0:outgoing>Flow_XOR_JMPAA_Te1_Par4_Par4</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Default_init_Rc1" sourceRef="Default_init" targetRef="Rc1" />
    <ns0:sequenceFlow id="Flow_Rc1_Fo1" sourceRef="Rc1" targetRef="Fo1" />
    <ns0:sequenceFlow id="Flow_Fo1_G0" sourceRef="Fo1" targetRef="G0" />
    <ns0:sequenceFlow id="Flow_G0_Ds1" sourceRef="G0" targetRef="Ds1" />
    <ns0:sequenceFlow id="Flow_G0_Par4" sourceRef="G0" targetRef="Par4" />
    <ns0:sequenceFlow id="Flow_Ds1_XORCLOSE10" sourceRef="Ds1" targetRef="XORCLOSE10" />
    <ns0:sequenceFlow id="Flow_Par4_Rs1" sourceRef="Par4" targetRef="Rs1" />
    <ns0:sequenceFlow id="Flow_Par4_Rh1" sourceRef="Par4" targetRef="Rh1" />
    <ns0:sequenceFlow id="Flow_Rs1_PARCLOSE7" sourceRef="Rs1" targetRef="PARCLOSE7" />
    <ns0:sequenceFlow id="Flow_Rh1_PARCLOSE7" sourceRef="Rh1" targetRef="PARCLOSE7" />
    <ns0:sequenceFlow id="Flow_PARCLOSE7_Te1" sourceRef="PARCLOSE7" targetRef="Te1" />
    <ns0:sequenceFlow id="Flow_Te1_XOR_JMPAA_Te1_Par4" sourceRef="Te1" targetRef="XOR_JMPAA_Te1_Par4" />
    <ns0:sequenceFlow id="Flow_Dr1_XORCLOSE10" sourceRef="Dr1" targetRef="XORCLOSE10" />
    <ns0:sequenceFlow id="Flow_XORCLOSE10_END" sourceRef="XORCLOSE10" targetRef="END" />
    <ns0:sequenceFlow id="Flow_XOR_JMPAA_Te1_Par4_Dr1" sourceRef="XOR_JMPAA_Te1_Par4" targetRef="Dr1" />
    <ns0:sequenceFlow id="Flow_XOR_JMPAA_Te1_Par4_Par4" sourceRef="XOR_JMPAA_Te1_Par4" targetRef="Par4" />
  </ns0:process>
