<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_001" isExecutable="false">
    <ns0:startEvent id="Default_init">
      <ns0:outgoing>Flow_Default_init_Rs1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="Rs1" name="Registrar solicita&#231;&#227;o">
      <ns0:incoming>Flow_Default_init_Rs1</ns0:incoming>
      <ns0:outgoing>Flow_Rs1_Cs1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Cs1" name="Classificar solicita&#231;&#227;o">
      <ns0:incoming>Flow_Rs1_Cs1</ns0:incoming>
      <ns0:outgoing>Flow_Cs1_Ac1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Ac1" name="Agendar atendimento presencial">
      <ns0:incoming>Flow_Cs1_Ac1</ns0:incoming>
      <ns0:outgoing>Flow_Ac1_G0</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="G0">
      <ns0:incoming>Flow_Ac1_G0</ns0:incoming>
      <ns0:outgoing>Flow_G0_Ep1</ns0:outgoing>
      <ns0:outgoing>Flow_G0_Es1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="Ep1" name="Executar atendimento presencial">
      <ns0:incoming>Flow_G0_Ep1</ns0:incoming>
      <ns0:outgoing>Flow_Ep1_XORCLOSE6</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Es1" name="Executar suporte t&#233;cnico">
      <ns0:incoming>Flow_G0_Es1</ns0:incoming>
      <ns0:outgoing>Flow_Es1_XORCLOSE6</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="XORCLOSE6">
      <ns0:incoming>Flow_Ep1_XORCLOSE6</ns0:incoming>
      <ns0:incoming>Flow_Es1_XORCLOSE6</ns0:incoming>
      <ns0:outgoing>Flow_XORCLOSE6_Nc1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="Nc1" name="Notificar cliente">
      <ns0:incoming>Flow_XORCLOSE6_Nc1</ns0:incoming>
      <ns0:outgoing>Flow_Nc1_Ec1</ns0:outgoing>
    </ns0:task>
    <ns0:task id="Ec1" name="Encerrar atendimento">
      <ns0:incoming>Flow_Nc1_Ec1</ns0:incoming>
      <ns0:outgoing>Flow_Ec1_END</ns0:outgoing>
    </ns0:task>
    <ns0:endEvent id="END">
      <ns0:incoming>Flow_Ec1_END</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Default_init_Rs1" sourceRef="Default_init" targetRef="Rs1" />
    <ns0:sequenceFlow id="Flow_Rs1_Cs1" sourceRef="Rs1" targetRef="Cs1" />
    <ns0:sequenceFlow id="Flow_Cs1_Ac1" sourceRef="Cs1" targetRef="Ac1" />
    <ns0:sequenceFlow id="Flow_Ac1_G0" sourceRef="Ac1" targetRef="G0" />
    <ns0:sequenceFlow id="Flow_G0_Ep1" sourceRef="G0" targetRef="Ep1" />
    <ns0:sequenceFlow id="Flow_G0_Es1" sourceRef="G0" targetRef="Es1" />
    <ns0:sequenceFlow id="Flow_Ep1_XORCLOSE6" sourceRef="Ep1" targetRef="XORCLOSE6" />
    <ns0:sequenceFlow id="Flow_Es1_XORCLOSE6" sourceRef="Es1" targetRef="XORCLOSE6" />
    <ns0:sequenceFlow id="Flow_XORCLOSE6_Nc1" sourceRef="XORCLOSE6" targetRef="Nc1" />
    <ns0:sequenceFlow id="Flow_Nc1_Ec1" sourceRef="Nc1" targetRef="Ec1" />
    <ns0:sequenceFlow id="Flow_Ec1_END" sourceRef="Ec1" targetRef="END" />
  </ns0:process>
